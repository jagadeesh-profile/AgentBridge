{
  "$ref": "#/definitions/InboxResponse",
  "definitions": {
    "InboxResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "thread": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "task": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "object",
                "properties": {
                  "untrusted": {
                    "type": "boolean",
                    "const": true
                  },
                  "provenance": {
                    "type": "object",
                    "properties": {
                      "from": {
                        "type": "string",
                        "pattern": "^agent:[a-z0-9][a-z0-9_-]{0,62}$",
                        "description": "A registered agent, always prefixed agent: — never a human account."
                      },
                      "sigVerified": {
                        "type": "boolean"
                      },
                      "receivedAt": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "from",
                      "sigVerified",
                      "receivedAt"
                    ],
                    "additionalProperties": false
                  },
                  "value": {}
                },
                "required": [
                  "untrusted",
                  "provenance"
                ],
                "additionalProperties": false
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "id",
              "thread",
              "type",
              "body",
              "created_at"
            ],
            "additionalProperties": false
          }
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "cursor"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
