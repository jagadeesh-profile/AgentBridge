{
  "$ref": "#/definitions/TaskListQuery",
  "definitions": {
    "TaskListQuery": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "submitted",
            "accepted",
            "working",
            "input-required",
            "needs-approval",
            "completed",
            "failed",
            "canceled"
          ],
          "description": "Filter by state, e.g. needs-approval."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
