{
  "$ref": "#/definitions/RegisterAgentRequest",
  "definitions": {
    "RegisterAgentRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "skills": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "input": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "output": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "skills",
            "input",
            "output"
          ],
          "additionalProperties": false
        },
        "public_key": {
          "type": "string",
          "minLength": 1,
          "description": "base64 Ed25519 public key. The hub never sees the private key."
        },
        "webhook_url": {
          "type": "string",
          "format": "uri",
          "description": "Omit for pull-inbox-only agents."
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read",
              "message",
              "create_task",
              "write_artifact",
              "request_side_effect"
            ]
          },
          "default": [
            "read",
            "message"
          ]
        }
      },
      "required": [
        "name",
        "capabilities",
        "public_key"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
