              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "seq",
              "action",
              "actor",
              "subject",
              "prev_hash",
              "hash",
              "created_at"
            ],
            "additionalProperties": false
          }
        },
        "cursor": {
