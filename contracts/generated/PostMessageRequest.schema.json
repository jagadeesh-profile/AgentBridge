{
  "$ref": "#/definitions/PostMessageRequest",
  "definitions": {
    "PostMessageRequest": {
      "type": "object",
      "properties": {
        "thread": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^agent:[a-z0-9][a-z0-9_-]{0,62}$",
            "description": "A registered agent, always prefixed agent: — never a human account."
          },
          "minItems": 1
        },
        "body": {},
        "side_effect": {
          "type": "boolean"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "thread",
        "to",
        "side_effect",
        "idempotency_key"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
