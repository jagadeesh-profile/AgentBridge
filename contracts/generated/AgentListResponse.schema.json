{
  "$ref": "#/definitions/AgentListResponse",
  "definitions": {
    "AgentListResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^agent:[a-z0-9][a-z0-9_-]{0,62}$",
                "description": "A registered agent, always prefixed agent: — never a human account."
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "read",
                    "message",
                    "create_task",
                    "write_artifact",
                    "request_side_effect"
                  ]
                }
              },
              "key_status": {
                "type": "string",
                "enum": [
                  "active",
                  "revoked"
                ]
              },
              "webhook_url": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "ref",
              "name",
              "scopes",
              "key_status",
              "webhook_url",
              "created_at"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
