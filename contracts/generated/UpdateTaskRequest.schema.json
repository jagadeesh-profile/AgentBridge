{
  "$ref": "#/definitions/UpdateTaskRequest",
  "definitions": {
    "UpdateTaskRequest": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "submitted",
            "accepted",
            "working",
            "input-required",
            "needs-approval",
            "completed",
            "failed",
            "canceled"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
